<Window x:Class="AudioEditor.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Export timeline" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,16" Text="{Binding Summary}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Grid.Row="2" Text="Format" VerticalAlignment="Center" Margin="0,0,16,0" />
        <ComboBox Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Format" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="3" Text="Sample rate" VerticalAlignment="Center" Margin="0,10,16,0" />
        <ComboBox Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Sample rate" Margin="0,10,0,0" ItemsSource="{Binding SampleRates}"
                  SelectedItem="{Binding SelectedSampleRate}" DisplayMemberPath="Name" />

        <TextBlock Grid.Row="4" Text="Channels" VerticalAlignment="Center" Margin="0,10,16,0" />
        <ComboBox Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Channels" Margin="0,10,0,0" ItemsSource="{Binding Channels}"
                  SelectedItem="{Binding SelectedChannels}" DisplayMemberPath="Name" />

        <TextBlock Grid.Row="5" Text="Quality" VerticalAlignment="Center" Margin="0,10,16,0"
                   Visibility="{Binding IsLossy, Converter={StaticResource BoolToVisibility}}" />
        <ComboBox Grid.Row="5" Grid.Column="1" AutomationProperties.Name="Quality" Margin="0,10,0,0" ItemsSource="{Binding BitRates}"
                  SelectedItem="{Binding SelectedBitRate}" DisplayMemberPath="Name"
                  Visibility="{Binding IsLossy, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MissingFormatsText}"
                   Visibility="{Binding HasMissingFormats, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Export…" IsDefault="True" MinWidth="100" Click="OnExport"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
